//colors.inc
//==========
//colors.inc one of samp colors include 
//IDarkness Colors inc
//==============================//
// Integer Colors (0xRRGGBBAA)
//==============================//

#define COLOR_WHITE        0xFFFFFFFF
#define COLOR_BLACK        0x000000FF
#define COLOR_GREY         0xAFAFAFFF
#define COLOR_RED          0xAA3333FF
#define COLOR_REALRED      0xFF0606FF
#define COLOR_GREEN        0x33AA33FF
#define COLOR_BLUE         0x0000FFFF
#define COLOR_LIGHTBLUE    0x33CCFFFF
#define COLOR_DARKBLUE     0x2641FEFF
#define COLOR_YELLOW       0xFFFF00FF
#define COLOR_GOLD         0xFFD700FF
#define COLOR_ORANGE       0xFF8000FF
#define COLOR_PINK         0xFF66FFFF
#define COLOR_PURPLE       0xC2A2DAFF
#define COLOR_CYAN         0x00FFFFFF
#define COLOR_AQUA         0x00FFFFFF
#define COLOR_BROWN        0xA52A2AFF
#define COLOR_LIGHTGREEN   0x9ACD32FF

//==============================//
// Embedded Colors ({RRGGBB})
//==============================//

#define EMBED_WHITE        "{FFFFFF}"
#define EMBED_BLACK        "{000000}"
#define EMBED_GREY         "{AFAFAF}"
#define EMBED_RED          "{AA3333}"
#define EMBED_REALRED      "{FF0606}"
#define EMBED_GREEN        "{33AA33}"
#define EMBED_BLUE         "{0000FF}"
#define EMBED_LIGHTBLUE    "{33CCFF}"
#define EMBED_DARKBLUE     "{2641FE}"
#define EMBED_YELLOW       "{FFFF00}"
#define EMBED_GOLD         "{FFD700}"
#define EMBED_ORANGE       "{FF8000}"
#define EMBED_PINK         "{FF66FF}"
#define EMBED_PURPLE       "{C2A2DA}"
#define EMBED_CYAN         "{00FFFF}"
#define EMBED_AQUA         "{00FFFF}"
#define EMBED_BROWN        "{A52A2A}"
#define EMBED_LIGHTGREEN   "{9ACD32}"